# Strava app credentials — get these at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here

# After deploying, set this to your live URL + /auth/callback
# Local dev: http://localhost:8000/auth/callback
STRAVA_REDIRECT_URI=http://localhost:8000/auth/callback

# Where the SQLite file lives (Render: use a persistent disk path)
DB_PATH=tracker.db
